+    if _existing is _KNOWN_MIMICGEN_COLLISIONS.get(_environment_name):
+        continue
+    _unknown_collisions.append(_environment_name)
+
+if _unknown_collisions:
+    raise RuntimeError(
+        "unknown public environment registry collision: {}".format(
+            ", ".join(sorted(_unknown_collisions))
+        )
+    )
 
