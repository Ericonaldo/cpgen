diff --git a/cpgen_envs/rs14_compat.py b/cpgen_envs/rs14_compat.py
new file mode 100644
index 0000000000000000000000000000000000000000..e37154d390cd93f77d94f1d0698e11b0613600d1
--- /dev/null
+++ b/cpgen_envs/rs14_compat.py
@@ -0,0 +1,131 @@
+import copy
+import xml.etree.ElementTree as ET
+
+import numpy as np
+
+
+_COMPOSITE_ROBOTS = {
+    "Panda_PandaGripper": ("Panda", "PandaGripper"),
+    "Panda_PandaUmiGripper": ("Panda", "PandaUmiGripper"),
+    "Sawyer_RethinkGripper": ("Sawyer", "RethinkGripper"),
+}
+
+
+def mount_type_for_base_type(base_type):
+    if base_type == "default":
+        return "default"
+    if base_type == "NullMount":
+        return None
+    raise ValueError("unsupported base type: {!r}".format(base_type))
+
+
+def split_composite_robot_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError("robot name must be a non-empty string")
+    if "_" not in name:
+        return name, None
+    try:
+        return _COMPOSITE_ROBOTS[name]
+    except KeyError:
+        raise ValueError("unsupported composite robot: {!r}".format(name))
+
+
+def normalize_rs14_robot_kwargs(robots, gripper_types="default", base_types="default"):
+    is_sequence = isinstance(robots, (list, tuple))
+    names = list(robots) if is_sequence else [robots]
+    if len(names) != 1:
+        raise ValueError("CPGen environments require exactly one robot")
+    robot, composite_gripper = split_composite_robot_name(names[0])
+    gripper = composite_gripper or gripper_types
+    return {
+        "robots": [robot] if is_sequence else robot,
+        "gripper_types": gripper,
+        "mount_types": mount_type_for_base_type(base_types),
+    }
+
+
+def _scale_vector(scale):
+    value = np.asarray(scale, dtype=float)
+    if value.ndim == 0:
+        value = np.repeat(value, 3)
+    if value.shape != (3,):
+        raise ValueError("scale must be a scalar or length-3 vector")
+    if not np.all(np.isfinite(value)) or np.any(value <= 0):
+        raise ValueError("scale values must be finite and positive")
+    return value
+
+
+def _scaled_position(text, scale):
+    values = np.fromstring(text, sep=" ")
+    if values.size != 3:
+        raise ValueError("positions and mesh scales must have three values")
+    return " ".join("{:.12g}".format(value) for value in values * scale[: values.size])
+
+
+def _scaled_size(text, scale):
+    values = np.fromstring(text, sep=" ")
+    if values.size == 3:
+        values *= scale
+    elif values.size == 2:
+        values *= (np.mean(scale[:2]), scale[2])
+    elif values.size == 1:
+        values *= np.mean(scale)
+    else:
+        raise ValueError("unsupported geom or site size dimensions")
+    return " ".join("{:.12g}".format(value) for value in values)
+
+
+def scaled_xml_tree(root, scale):
+    result = copy.deepcopy(root)
+    factors = _scale_vector(scale)
+    for element in result.iter():
+        position = element.get("pos")
+        if position is not None and element.tag in {"body", "geom", "joint", "site"}:
+            element.set("pos", _scaled_position(position, factors))
+        mesh_scale = element.get("scale")
+        if mesh_scale is not None and element.tag == "mesh":
+            element.set("scale", _scaled_position(mesh_scale, factors))
+        size = element.get("size")
+        if size is not None and element.tag in {"geom", "site"}:
+            element.set("size", _scaled_size(size, factors))
+    return result
+
+
+def _scale_roots_in_place(roots, scale, *, skip_root_body_position=False):
+    factors = _scale_vector(scale)
+    seen = set()
+    for root in roots:
+        if root is None:
+            continue
+        for element in root.iter():
+            if id(element) in seen:
+                continue
+            seen.add(id(element))
+            position = element.get("pos")
+            if position is not None and element.tag in {"body", "geom", "joint", "site"}:
+                if not (skip_root_body_position and element is root and element.tag == "body"):
+                    element.set("pos", _scaled_position(position, factors))
+            mesh_scale = element.get("scale")
+            if mesh_scale is not None and element.tag == "mesh":
+                element.set("scale", _scaled_position(mesh_scale, factors))
+            size = element.get("size")
+            if size is not None and element.tag in {"geom", "site"}:
+                element.set("size", _scaled_size(size, factors))
+    return factors
+
+
+def scale_xml_object_rs14(model, scale):
+    factors = _scale_roots_in_place(
+        (getattr(model, "_obj", None), getattr(model, "asset", None), getattr(model, "worldbody", None)),
+        scale,
+    )
+    model._cpgen_scale = factors
+    return model
+
+
+def scale_arena_body_rs14(arena, body_name, scale):
+    body = arena.worldbody.find("./body[@name='{}']".format(body_name))
+    if body is None:
+        raise ValueError("arena body {!r} not found".format(body_name))
+    _scale_roots_in_place((body,), scale, skip_root_body_position=True)
+    return arena
